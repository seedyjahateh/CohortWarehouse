# Copy to .env and replace every CHANGE_ME value. .env is git-ignored.
# The CLI reads these from the process environment; `python -m cohortwarehouse` also
# loads ./.env when present (values already set in the environment win).

CW_PG_HOST=127.0.0.1
CW_PG_PORT=5433
CW_PG_DATABASE=cohortwarehouse

# Bootstrap/administration only (container superuser). Never used by pipeline stages.
CW_ADMIN_USER=cw_admin
CW_ADMIN_PASSWORD=CHANGE_ME

# Least-privilege stage users created by `python -m cohortwarehouse bootstrap`
CW_LOADER_USER=cw_loader
CW_LOADER_PASSWORD=CHANGE_ME
CW_TRANSFORMER_USER=cw_transformer
CW_TRANSFORMER_PASSWORD=CHANGE_ME
CW_PUBLISHER_USER=cw_publisher
CW_PUBLISHER_PASSWORD=CHANGE_ME
CW_BI_READER_USER=cw_bi_reader
CW_BI_READER_PASSWORD=CHANGE_ME
CW_OMOP_READER_USER=cw_omop_reader
CW_OMOP_READER_PASSWORD=CHANGE_ME

# dbt executable (an isolated virtual environment inside the Airflow image)
CW_DBT_EXECUTABLE=dbt

# Validation profile: fixture (fictional test vocabulary allowed) | release (real vocabulary required)
CW_VALIDATION_PROFILE=fixture

# Airflow (only for `docker compose --profile airflow up`)
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
CW_DELIVERY_ROOT=/opt/cohortwarehouse/data/deliveries
